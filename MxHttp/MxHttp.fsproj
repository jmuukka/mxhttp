<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.3.0</Version>
    <Authors>jmuukka</Authors>
    <Company>Mutex Oy</Company>
    <PackageTags>HTTP;F#;fsharp</PackageTags>
    <Description>A functional implementation of HTTP client built on top of System.Net.Http.</Description>
    <PackageProjectUrl>https://github.com/jmuukka/mxhttp</PackageProjectUrl>
    <Title>MxHttp</Title>
    <Copyright>Copyright (c) 2026 Jarmo Muukka, Mutex Oy</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>5</WarningLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>5</WarningLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MediaType.fs" />
    <Compile Include="Uri.fs" />
    <Compile Include="Header.fs" />
    <Compile Include="Request.fsi" />
    <Compile Include="Request.fs" />
    <Compile Include="Private.fs" />
    <Compile Include="Response.fsi" />
    <Compile Include="Response.fs" />
    <Compile Include="Http.fsi" />
    <Compile Include="Http.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
